{
  "name": "thryftverse-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"src/integration/**/*.test.ts\"",
    "backup:db": "node scripts/postgres-backup.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:rollback": "tsx src/db/migrate.ts down",
    "seed": "tsx scripts/seed-dev-data.ts",
    "start": "node --enable-source-maps dist/index.js",
    "smoke:commerce": "node scripts/smoke-commerce-flow.mjs",
    "smoke:coown": "node scripts/smoke-coown-flow.mjs",
    "smoke:profile": "node scripts/smoke-profile-flow.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:recommendations": "node scripts/recommendation-health.mjs",
    "db:types": "kysely-codegen --dialect postgres --out-file src/lib/database-types.ts --exclude-pattern '(pg_catalog.*|information_schema.*)'",
    "search:sync": "tsx src/scripts/searchSync.ts",
    "worker:start": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.882.0",
    "@aws-sdk/s3-request-presigner": "^3.882.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.2.0",
    "@mollie/api-client": "^4.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.67.0",
    "@simplewebauthn/server": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.8.4",
    "fastify-raw-body": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^5.7.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "livekit-server-sdk": "^2.18.0",
    "meilisearch": "^0.60.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "undici": "^8.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
