# Thryftverse Backend API — Stripe Live Configuration
# DO NOT COMMIT THIS FILE (gitignored)
#
# Generated by scripts/setup-stripe-env.mjs on 2026-09-02T17:16:51.028Z
# Get your API keys from: https://dashboard.stripe.com/apikeys

# ── Core ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=https://api.thryftverse.com

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://thryftverse:thryftverse@localhost:5432/thryftverse

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Key Service ──────────────────────────────────────────
KEY_SERVICE_URL=http://localhost:4100
KEY_SERVICE_CLIENT_TOKEN=local-key-client-token
KEY_SERVICE_ADMIN_TOKEN=local-key-admin-token

# ── S3 / MinIO ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=thryftverse-media
S3_FORCE_PATH_STYLE=true

# ── Stripe (LIVE) ────────────────────────────────────────
# [required] Get from https://dashboard.stripe.com/apikeys
# Live secret key starts with sk_live_
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_SECRET_KEY
# [required] Live publishable key starts with pk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_LIVE_PUBLISHABLE_KEY

# [required] Payment webhook signing secret
# Webhook endpoint: https://api.thryftverse.com/webhooks/stripe
# Endpoint ID: we_1UBHlKKvjxheHABaDawXpSHn
STRIPE_WEBHOOK_SECRET=whsec_ighAjmOsoGcjFNsnAvYOber65adSdHok

# [required for KYC] Identity webhook signing secret (separate endpoint)
# Webhook endpoint: https://api.thryftverse.com/compliance/kyc/webhooks/stripe
# Endpoint ID: we_1UBHlOKvjxheHABaZWofOUvv
KYC_WEBHOOK_SECRET=whsec_UwRLaJCZwmLyA1luo6vE165apP9vRzwP

# [optional] Apple Pay merchant identifier
STRIPE_APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.thryftverse.app
# [optional] Enable Google Pay via Stripe
STRIPE_GOOGLE_PAY_ENABLED=true
# [required-prod] Merchant country code
STRIPE_MERCHANT_COUNTRY_CODE=GB

# [required] HMAC secret for payment metadata integrity
PAYMENT_METADATA_HMAC_SECRET=dev-only-payment-metadata-hmac-secret

# ── KYC ──────────────────────────────────────────────────
KYC_DEFAULT_VENDOR=stripe_identity
KYC_RETURN_URL=thryftverse://compliance/kyc-complete

# ── Security ─────────────────────────────────────────────
API_SECURITY_ADMIN_TOKEN=local-security-admin-token
API_INTERNAL_SERVICE_TOKEN=local-internal-service-token

# ── Payout Safeguards ────────────────────────────────────
BUYER_PROTECTION_HOLD_HOURS=48
PAYOUT_DEFAULT_MINIMUM_GBP=10
DAILY_PAYOUT_VELOCITY_LIMIT_GBP=2000
PAYOUT_MANUAL_REVIEW_THRESHOLD_GBP=500
