# Thryftverse Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Legend:
#   [required]     Must be set or the app will not start.
#   [required-prod] Required only in production (dev fallback exists).
#   [optional]     Has a sensible default; override as needed.
#   [secret]       Sensitive credential — use a long random value, never commit.

# ── Core ─────────────────────────────────────────────────
# [optional] Application runtime environment. Default: development
NODE_ENV=development
# [optional] HTTP listen port. Default: 4000
PORT=4000
# [required-prod] Public HTTPS base URL of the API (used for callbacks, magic links). Default: http://localhost:4000
APP_URL=http://localhost:4000
# [required] PostgreSQL connection string. No default.
DATABASE_URL=postgresql://thryftverse:thryftverse@localhost:5432/thryftverse
# [optional] Read-replica DSN for scaled read workloads. Default: none
# DATABASE_REPLICA_URL=
# [optional] Max DB pool connections. Default: 20
DATABASE_POOL_MAX=20
# [optional] Idle connection timeout (ms). Default: 30000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# [optional] Connection acquisition timeout (ms). Default: 10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# [optional] Per-statement timeout (ms). Default: 30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# [optional] Per-query timeout (ms). Default: 35000
DATABASE_QUERY_TIMEOUT_MS=35000
# [required-prod] Redis connection URL. Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Key Service ──────────────────────────────────────────
# [required-prod] Key-management service base URL. Default: http://localhost:4100
KEY_SERVICE_URL=http://localhost:4100
# [required-prod] [secret] Service-to-service client token. Default: local-key-client-token
KEY_SERVICE_CLIENT_TOKEN=local-key-client-token
# [required-prod] [secret] Key-service admin token. Default: local-key-admin-token
KEY_SERVICE_ADMIN_TOKEN=local-key-admin-token

# ── S3 / MinIO ───────────────────────────────────────────
# [required-prod] S3-compatible endpoint. Default: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
# [required-prod] Public-facing S3 endpoint. Default: S3_ENDPOINT
S3_PUBLIC_ENDPOINT=http://localhost:9000
# [required-prod] S3 region. Default: us-east-1
S3_REGION=us-east-1
# [required-prod] [secret] S3 access key. Default: minioadmin
S3_ACCESS_KEY=minioadmin
# [required-prod] [secret] S3 secret key. Default: minioadmin
S3_SECRET_KEY=minioadmin
# [required-prod] S3 bucket name. Default: thryftverse-media
S3_BUCKET=thryftverse-media
# [optional] Use path-style S3 addressing. Default: true
S3_FORCE_PATH_STYLE=true
# [optional] CDN base URL for media delivery. Default: S3_PUBLIC_ENDPOINT
S3_CDN_BASE_URL=http://localhost:9000
# [optional] Enable server-side media processing. Default: false
MEDIA_PROCESSING_ENABLED=false
# [optional] Gate media publication until processing completes. Default: false (true in production)
MEDIA_PUBLICATION_GATE_ENABLED=false
# [optional] Max image upload size (bytes). Default: 20971520 (20 MB)
S3_MAX_IMAGE_UPLOAD_BYTES=20971520
# [optional] Max video upload size (bytes). Default: 104857600 (100 MB)
S3_MAX_VIDEO_UPLOAD_BYTES=104857600
# [optional] Max document upload size (bytes). Default: 10485760 (10 MB)
S3_MAX_DOCUMENT_UPLOAD_BYTES=10485760
# [optional] Presigned URL TTL (seconds). Default: 600
S3_PRESIGN_TTL_SECONDS=600
# [optional] Comma-separated allowed content types. Default: image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,video/mp4,video/quicktime,video/x-m4v,application/pdf,text/plain
# S3_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,video/mp4,video/quicktime,video/x-m4v,application/pdf,text/plain

# ── Decision / ML Service ────────────────────────────────
# [optional] Decision service base URL. Default: http://localhost:8000
DECISION_SERVICE_URL=http://localhost:8000
# [optional] Decision service request timeout (ms). Default: 2500
DECISION_SERVICE_TIMEOUT_MS=2500
# [required-prod] [secret] Decision service auth token. Default: local-decision-service-token
DECISION_SERVICE_TOKEN=replace-with-a-long-random-service-secret
# ML_SERVICE_URL remains accepted as a legacy alias for DECISION_SERVICE_URL.

# ── Auth ─────────────────────────────────────────────────
# [required-prod] [secret] JWT access-token signing secret. Default: dev-only-access-secret-change-me
AUTH_ACCESS_TOKEN_SECRET=your-access-token-secret
# [required-prod] [secret] JWT refresh-token signing secret. Default: dev-only-refresh-secret-change-me
AUTH_REFRESH_TOKEN_SECRET=your-refresh-token-secret
# [optional] Access-token TTL (seconds). Default: 900
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# [optional] Refresh-token TTL (seconds). Default: 2592000 (30 days)
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# [optional] bcrypt password hash cost. Default: 12
AUTH_PASSWORD_HASH_COST=12
# [optional] Password-reset token TTL (seconds). Default: 1200 (20 min)
# AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1200
# [optional] Magic-link token TTL (seconds). Default: 900 (15 min)
# AUTH_MAGIC_LINK_TTL_SECONDS=900
# [optional] Magic-link base URL (deep-link scheme). Default: thryftverse://auth/magic-link
# AUTH_MAGIC_LINK_BASE_URL=thryftverse://auth/magic-link
# [optional] OTP TTL (seconds). Default: 300 (5 min)
# AUTH_OTP_TTL_SECONDS=300
# [optional] OTP max verification attempts. Default: 5
# AUTH_OTP_MAX_ATTEMPTS=5
# [optional] Email provider: log | resend. Default: log (resend in production)
AUTH_EMAIL_PROVIDER=log
# [optional] Expose development-only auth artifacts. Default: false
# AUTH_EXPOSE_DEVELOPMENT_ARTIFACTS=false
# [optional] From-address for transactional emails. Default: none
# AUTH_EMAIL_FROM=noreply@thryftverse.app
# [optional] [secret] Resend API key. Default: none
# RESEND_API_KEY=your-resend-api-key

# ── AI / OpenAI ──────────────────────────────────────────
# [optional] [secret] OpenAI API key for chat agents. Default: none
# OPENAI_API_KEY=sk-proj-...
# [optional] OpenAI base URL. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# [optional] Default agent model. Default: gpt-5.6-terra
# OPENAI_AGENT_DEFAULT_MODEL=gpt-5.6-terra
# [optional] Max agent output tokens. Default: 900
# OPENAI_AGENT_MAX_OUTPUT_TOKENS=900
# [optional] Agent request timeout (ms). Default: 30000
# OPENAI_AGENT_TIMEOUT_MS=30000
# [optional] AI usage pricing version label. Default: unconfigured
# AI_USAGE_PRICING_VERSION=
# [optional] Input cost (micro-USD per million tokens). Default: 0
# OPENAI_INPUT_COST_MICROUSD_PER_MILLION_TOKENS=0
# [optional] Output cost (micro-USD per million tokens). Default: 0
# OPENAI_OUTPUT_COST_MICROUSD_PER_MILLION_TOKENS=0

# ── Google / Apple OAuth ─────────────────────────────────
# [optional] Comma-separated Google OAuth client IDs.
# GOOGLE_OAUTH_CLIENT_IDS=your-android-client-id,your-ios-client-id,your-web-client-id
# [optional] Apple OAuth audience (App ID).
# APPLE_OAUTH_AUDIENCE=com.thryftverse.app

# ── Payment Providers ────────────────────────────────────
# At least one complete provider set is required in production.
# [optional] [secret] Stripe secret key.
# STRIPE_SECRET_KEY=sk_test_xxx
# [optional] Stripe publishable key.
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# [optional] [secret] Stripe webhook signing secret.
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# [optional] Apple Pay merchant identifier.
# STRIPE_APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.thryftverse.app
# [optional] Enable Google Pay via Stripe. Default: false
# STRIPE_GOOGLE_PAY_ENABLED=false
# [required-prod] [secret] HMAC secret for payment metadata integrity. Default: dev-only-payment-metadata-hmac-secret
# PAYMENT_METADATA_HMAC_SECRET=replace-with-a-dedicated-random-secret
# [optional] Webhook timestamp tolerance (seconds). Default: 300
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# [optional] [secret] Razorpay key ID.
# RAZORPAY_KEY_ID=rzp_test_xxx
# [optional] [secret] Razorpay key secret.
# RAZORPAY_KEY_SECRET=xxx
# [optional] [secret] Razorpay webhook secret.
# RAZORPAY_WEBHOOK_SECRET=xxx
# [optional] [secret] Mollie API key.
# MOLLIE_API_KEY=
# [optional] [secret] Mollie webhook secret.
# MOLLIE_WEBHOOK_SECRET=
# [optional] [secret] Flutterwave secret key.
# FLUTTERWAVE_SECRET_KEY=
# [optional] [secret] Flutterwave webhook secret.
# FLUTTERWAVE_WEBHOOK_SECRET=
# [optional] [secret] Tap secret key.
# TAP_SECRET_KEY=
# [optional] [secret] Tap webhook secret.
# TAP_WEBHOOK_SECRET=
# [optional] [secret] Wise API key.
# WISE_API_KEY=your-wise-api-key
# [optional] [secret] Wise webhook secret.
# WISE_WEBHOOK_SECRET=your-wise-webhook-secret
# [optional] Wise API base URL. Default: https://api.wise.com
# WISE_API_BASE_URL=https://api.wise.com
# [optional] Wise platform profile ID.
# WISE_PLATFORM_PROFILE_ID=
# [optional] Wise platform recipient account ID.
# WISE_PLATFORM_RECIPIENT_ACCOUNT_ID=
# [optional] Wise transfer reference prefix. Default: THRYFTVERSE SWEEP
# WISE_PLATFORM_TRANSFER_REFERENCE_PREFIX=THRYFTVERSE SWEEP
# [optional] PayPal client ID.
# PAYPAL_CLIENT_ID=
# [optional] [secret] PayPal client secret.
# PAYPAL_CLIENT_SECRET=
# [optional] PayPal API base URL. Default: https://api-m.sandbox.paypal.com (sandbox) / https://api-m.paypal.com (production)
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# ── Payout Safeguards / Escrow ───────────────────────────
# [optional] Buyer-protection hold duration (hours). Default: 48
# BUYER_PROTECTION_HOLD_HOURS=48
# [optional] Default minimum payout amount (GBP). Default: 10
# PAYOUT_DEFAULT_MINIMUM_GBP=10
# [optional] New-seller rolling reserve percentage. Default: 10
# PAYOUT_NEW_SELLER_RESERVE_PCT=10
# [optional] New-seller reserve release period (days). Default: 14
# PAYOUT_NEW_SELLER_RESERVE_RELEASE_DAYS=14
# [optional] New-seller threshold (order count). Default: 10
# PAYOUT_NEW_SELLER_THRESHOLD=10
# [optional] Elevated risk-tier reserve percentage. Default: 5
# SELLER_RISK_TIER_ELEVATED_RESERVE_PCT=5
# [optional] High risk-tier reserve percentage. Default: 15
# SELLER_RISK_TIER_HIGH_RESERVE_PCT=15

# ── Shipping Providers (optional, falls back to static rates) ───────
# [optional] [secret] Evri API key.
# EVRI_API_KEY=
# [optional] Evri API base URL.
# EVRI_API_BASE_URL=https://api.evri.example
# [optional] [secret] Evri webhook secret.
# EVRI_WEBHOOK_SECRET=
# [optional] [secret] Delhivery API key.
# DELHIVERY_API_KEY=
# [optional] Delhivery API base URL.
# DELHIVERY_API_BASE_URL=https://track.delhivery.example
# [optional] [secret] Delhivery webhook secret.
# DELHIVERY_WEBHOOK_SECRET=
# [optional] [secret] DHL API key.
# DHL_API_KEY=
# [optional] DHL API base URL.
# DHL_API_BASE_URL=https://api.dhl.example
# [optional] [secret] DHL webhook secret.
# DHL_WEBHOOK_SECRET=
# [optional] [secret] Aramex API key.
# ARAMEX_API_KEY=
# [optional] Aramex API base URL.
# ARAMEX_API_BASE_URL=https://api.aramex.example
# [optional] [secret] Aramex webhook secret.
# ARAMEX_WEBHOOK_SECRET=
# [optional] [secret] Easyship API key.
# EASYSHIP_API_KEY=
# [optional] Easyship API base URL. Default: https://public-api.easyship.com/2024-09
# EASYSHIP_API_BASE_URL=https://public-api.easyship.com/2024-09
# [optional] [secret] Easyship webhook secret.
# EASYSHIP_WEBHOOK_SECRET=
# [optional] Fallback shipping label base URL. Default: https://thryftverse.app/mock-shipping
SHIPPING_FALLBACK_LABEL_BASE_URL=https://thryftverse.app/mock-shipping
# Legacy aliases (SHIPPING_EVRI_API_KEY, SHIPPING_EVRI_API_URL, etc.) are still accepted.

# ── KYC ──────────────────────────────────────────────────
# [required-prod] KYC vendor: stripe_identity | persona | onfido. Default: stripe_identity
KYC_DEFAULT_VENDOR=stripe_identity
# [required-prod] KYC completion return URL.
KYC_RETURN_URL=thryftverse://compliance/kyc-complete
# [optional] [secret] KYC webhook secret.
# KYC_WEBHOOK_SECRET=whsec_xxx
# [optional] Legacy dev-only KYC verification base URL. Not used by Stripe Identity.
# KYC_VERIFICATION_BASE_URL=https://verify.thryftverse.local/session
# [optional] [secret] Persona API key (required if KYC_DEFAULT_VENDOR=persona).
# PERSONA_API_KEY=
# [optional] Persona template ID (required if KYC_DEFAULT_VENDOR=persona).
# PERSONA_TEMPLATE_ID=
# [optional] [secret] Persona webhook secret (required if KYC_DEFAULT_VENDOR=persona).
# PERSONA_WEBHOOK_SECRET=
# [optional] Persona API base URL. Default: https://withpersona.com/api/v1
# PERSONA_API_BASE_URL=https://withpersona.com/api/v1
# [optional] [secret] Onfido API key (required if KYC_DEFAULT_VENDOR=onfido).
# ONFIDO_API_KEY=
# [optional] [secret] Onfido webhook token (required if KYC_DEFAULT_VENDOR=onfido).
# ONFIDO_WEBHOOK_TOKEN=
# [optional] Onfido API base URL. Default: https://api.onfido.com/v3.5
# ONFIDO_API_BASE_URL=https://api.onfido.com/v3.5

# ── Security ─────────────────────────────────────────────
# [required-prod] [secret] API security admin token. Default: local-security-admin-token
API_SECURITY_ADMIN_TOKEN=local-security-admin-token
# [required-prod] [secret] Internal service-to-service token. Default: local-internal-service-token
API_INTERNAL_SERVICE_TOKEN=local-internal-service-token
# [optional] Enable mock webhooks for development. Default: false
# API_ENABLE_MOCK_WEBHOOKS=false
# [optional] Global rate-limit max requests per window. Default: 140
API_RATE_LIMIT_MAX=140
# [optional] Global rate-limit window (duration string). Default: 1 minute
API_RATE_LIMIT_WINDOW=1 minute
# [optional] CORS allow-list for browser origins (comma-separated). Defaults to empty (native-mobile API only).
# Include the production web domain and any local dev origins used for browser previews.
# CORS_ALLOWED_ORIGINS=https://thryftverse.app,https://admin.thryftverse.app
CORS_ALLOWED_ORIGINS=https://thryftverse.com,https://www.thryftverse.com,http://localhost:8082,http://localhost:19006,http://localhost:19000
# [optional] Per-endpoint auth rate limit (login/signup/password-reset/otp/magic-link). Default: 10
AUTH_RATE_LIMIT_MAX=10
# [optional] Auth rate-limit window (ms). Default: 900000 (15 min)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# [optional] Outbox drain interval (ms). Default: 5000
# OUTBOX_DRAIN_INTERVAL_MS=5000
# [optional] Enable webhook IP allowlist. Default: false
# WEBHOOK_IP_ALLOWLIST_ENABLED=false
# [optional] Comma-separated CIDR ranges allowed for webhooks.
# WEBHOOK_ALLOWLISTED_IP_RANGES=

# ── Payout Safeguards / Reconciliation ───────────────────
# [optional] Daily payout velocity limit (GBP). Default: 2000
DAILY_PAYOUT_VELOCITY_LIMIT_GBP=2000
# [optional] Manual review threshold per payout (GBP). Default: 500
PAYOUT_MANUAL_REVIEW_THRESHOLD_GBP=500
# [optional] Reconciliation schedule hour (UTC). Default: 2
RECONCILIATION_SCHEDULE_UTC_HOUR=2
# [optional] Reconciliation mismatch threshold (GBP). Default: 1
RECONCILIATION_MISMATCH_THRESHOLD_GBP=1
# [optional] Reconciliation critical mismatch threshold (GBP). Default: 10
RECONCILIATION_CRITICAL_MISMATCH_THRESHOLD_GBP=10
# [optional] Ops alert check interval (ms). Default: 60000
OPS_ALERT_INTERVAL_MS=60000
# [optional] Platform revenue sweep interval (ms). Default: 21600000 (6 hours)
PLATFORM_REVENUE_SWEEP_INTERVAL_MS=21600000
# [optional] External transfer gateway for platform revenue sweep.
# PLATFORM_REVENUE_SWEEP_GATEWAY=wise
# [optional] Require external transfer for revenue sweep. Default: false
# PLATFORM_REVENUE_SWEEP_REQUIRE_EXTERNAL_TRANSFER=false
# [optional] Comma-separated alerting webhook URLs (https only).
# ALERTING_WEBHOOK_URLS=https://hooks.slack.com/services/xxx,https://discord.com/api/webhooks/xxx
# Legacy alias: ALERTING_WEBHOOK_URL
# [optional] Comma-separated admin user IDs for alerts.
# ALERTING_ADMIN_USER_IDS=admin_user_1,admin_user_2

# ── Observability ────────────────────────────────────────
# [optional] Sentry DSN for error tracking.
# SENTRY_DSN=https://xxx@sentry.io/xxx
# [optional] Sentry traces sample rate. Default: 0.15
# SENTRY_TRACES_SAMPLE_RATE=0.15
# [optional] Enable OpenTelemetry. Default: true
OTEL_ENABLED=true
# [optional] OTLP HTTP traces endpoint. Default: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HTTP_URL=http://localhost:4318/v1/traces

# ── Push Notifications ───────────────────────────────────
# [optional] Expo push API URL. Default: https://exp.host/--/api/v2/push/send
# EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
# [optional] Default push notification channel. Default: default
# PUSH_DEFAULT_CHANNEL=default

# ── Background Jobs ──────────────────────────────────────
# [optional] Auction sweep interval (ms). Default: 30000
# AUCTION_SWEEP_INTERVAL_MS=30000

# ── 1ze Controlled Monetary System ───────────────────────
# The controlled pricing engine uses DB-backed anchor + country policies.
# Gold oracle settings are deprecated and should stay unset.
# [optional] Supply drift threshold (1ze). Default: 10
ONEZE_SUPPLY_DRIFT_THRESHOLD_IZE=10
# [optional] Enable direct 1ze redemption. Default: false
ONEZE_ENABLE_DIRECT_REDEMPTION=false
# [optional] [secret] 1ze operator admin token.
ONEZE_OPERATOR_TOKEN=local-security-admin-token
# [optional] Enable reserve policy enforcement. Default: false
ONEZE_RESERVE_POLICY_ENABLED=false
# [optional] Minimum reserve ratio. Default: 0.30
ONEZE_RESERVE_RATIO_MIN=0.30
# [optional] Maximum reserve ratio. Default: 0.60
ONEZE_RESERVE_RATIO_MAX=0.60
# [optional] Source-of-truth operational reserve input (mg). Default: 0
ONEZE_OPERATIONAL_RESERVE_MG=0
# [optional] Enable FX sync. Default: false
ONEZE_FX_SYNC_ENABLED=false
# [optional] FX sync interval (ms). Default: 86400000 (24 hours)
ONEZE_FX_SYNC_INTERVAL_MS=86400000
# [optional] FX provider URL. Default: https://api.exchangerate.host/latest
ONEZE_FX_PROVIDER_URL=https://api.exchangerate.host/latest
# [optional] [secret] FX provider API key.
# ONEZE_FX_PROVIDER_API_KEY=
# [optional] FX provider base currency. Default: INR
ONEZE_FX_PROVIDER_BASE_CURRENCY=INR
# [optional] Enable auto-adjust. Default: false
ONEZE_AUTO_ADJUST_ENABLED=false
# [optional] Auto-adjust interval (ms). Default: 3600000 (1 hour)
ONEZE_AUTO_ADJUST_INTERVAL_MS=3600000
# [optional] Auto-adjust step (basis points). Default: 50
ONEZE_AUTO_ADJUST_STEP_BPS=50
# [optional] Auto-adjust lookback window (hours). Default: 24
ONEZE_AUTO_ADJUST_LOOKBACK_HOURS=24
# [optional] Auto-adjust high stress threshold. Default: 0.85
ONEZE_AUTO_ADJUST_HIGH_STRESS_THRESHOLD=0.85
# [optional] Auto-adjust low stress threshold. Default: 0.35
ONEZE_AUTO_ADJUST_LOW_STRESS_THRESHOLD=0.35
# [optional] Auto-adjust high redemption rate. Default: 0.80
ONEZE_AUTO_ADJUST_HIGH_REDEMPTION_RATE=0.80
# [optional] Auto-adjust low redemption rate. Default: 0.25
ONEZE_AUTO_ADJUST_LOW_REDEMPTION_RATE=0.25
# [optional] 1ze reconcile interval (ms). Default: 3600000 (1 hour)
# ONEZE_RECONCILE_INTERVAL_MS=3600000
# [optional] Mint quote TTL (seconds). Default: 60
# ONEZE_MINT_QUOTE_TTL_SECONDS=60
# [optional] Mint payment grace period (seconds). Default: 300
# ONEZE_MINT_PAYMENT_GRACE_SECONDS=300
# [optional] Withdrawal quote TTL (seconds). Default: 60
# ONEZE_WITHDRAWAL_QUOTE_TTL_SECONDS=60
# [optional] Instant withdrawal limit (mg). Default: 20000
# ONEZE_WITHDRAWAL_INSTANT_LIMIT_MG=20000
# [optional] Travel-rule threshold (mg). Default: 11000
# ONEZE_TRAVEL_RULE_THRESHOLD_MG=11000
# [optional] Daily attestation interval (ms). Default: 86400000 (24 hours)
# ONEZE_DAILY_ATTESTATION_INTERVAL_MS=86400000
# [required-prod] [secret] 1ze attestation signing secret. Default: dev-only-oneze-attestation-signing-secret
ONEZE_ATTESTATION_SIGNING_SECRET=dev-only-oneze-attestation-signing-secret
