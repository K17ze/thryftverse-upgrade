{
  "name": "thryftverse",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api ml-service key-service postgres redis minio",
    "docker:check": "node backend/scripts/docker-smoke-check.mjs",
    "typecheck": "tsc --noEmit",
    "lint:design-tokens": "node scripts/check-design-tokens.mjs",
    "check": "npm run typecheck",
    "check:animated-scroll": "node scripts/check-animated-scroll-usage.mjs",
    "check:maestro-flows": "node scripts/check-maestro-flows.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:visual-gates": "node scripts/check-visual-release-gates.mjs",
    "doctor": "npx expo-doctor",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "test:smoke": "vitest run src/__tests__/smoke-flows.test.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "verify:phase": "npm run typecheck && npm run check:animated-scroll && npm run lint:design-tokens && vitest run src/__tests__/premium-form-primitives.test.ts src/__tests__/animated-scroll-usage.test.ts src/__tests__/platformCapabilities.test.ts src/__tests__/platformRuntime.test.ts",
    "i18n:extract": "node scripts/extract-i18n-strings.mjs",
    "deploy:prod:validate": "node scripts/validate-production-env.mjs .env.production",
    "docker:up:prod": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:down:prod": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:logs:prod": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml logs -f api ml-service key-service",
    "staging:shipping-ops": "node backend/scripts/staging-shipping-ops-rehearsal.mjs",
    "launch:phase8": "node backend/scripts/phase8-launch-ops.mjs --strict",
    "launch:phase8:full": "node backend/scripts/phase8-launch-ops.mjs --strict --run-rehearsal",
    "launch:phase8:cleanup:dry": "node backend/scripts/phase8-launch-ops.mjs --cleanup-db",
    "launch:phase8:cleanup:apply": "node backend/scripts/phase8-launch-ops.mjs --cleanup-db --confirm-db-cleanup"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.0",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lobster": "^0.4.1",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/ui": "~57.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.13",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/react-query": "^5.101.1",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.10",
    "expo-auth-session": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-observe": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.13",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "^4.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.3",
    "tslib": "^2.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "eslint-plugin-react-hooks": "^5.1.0-beta-26f2496093-20240514",
    "expo-doctor": "^1.19.10",
    "react-refresh": "^0.17.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "ENABLE_SHARED_ELEMENT_TRANSITIONS": true
    }
  }
}
