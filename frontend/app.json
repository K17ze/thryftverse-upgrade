{
  "expo": {
    "name": "thryftverse",
    "slug": "thryftverse",
    "scheme": "thryftverse",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.thryftverse.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:thryftverse.com",
        "applinks:www.thryftverse.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "ThryftVerse needs camera access to capture photos and videos for listings, posters, and looks.",
        "NSPhotoLibraryUsageDescription": "ThryftVerse needs photo library access to select images for listings, posters, and looks.",
        "NSPhotoLibraryAddUsageDescription": "ThryftVerse needs photo library access to save captured photos.",
        "NSUserTrackingUsageDescription": "ThryftVerse does not track you across other companies' apps or websites.",
        "NSFaceIDUsageDescription": "ThryftVerse uses Face ID to protect your wallet, payments, and account settings.",
        "NSMicrophoneUsageDescription": "ThryftVerse needs microphone access to record audio with video captures."
      }
    },
    "android": {
      "package": "com.thryftverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thryftverse.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.thryftverse.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "thryftverse"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPrivacyManifest",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select images for posters.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save poster photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-updates",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e94afae8-2794-4230-a184-785eb8d7ad36"
      }
    },
    "owner": "kha1ze",
    "updates": {
      "url": "https://u.expo.dev/e94afae8-2794-4230-a184-785eb8d7ad36",
      "checkAutomatically": "ON_LOAD",
      "enableBsdiffPatchSupport": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
