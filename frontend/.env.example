# Thryftverse — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── API ──────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Google OAuth ─────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_OAUTH_CLIENT_IDS=your-android-client-id,your-ios-client-id,your-web-client-id

# ── Apple OAuth ──────────────────────────────────────────
APPLE_OAUTH_AUDIENCE=com.thryftverse.app

# ── Stripe ───────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
EXPO_PUBLIC_STRIPE_APPLE_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_STRIPE_GOOGLE_PAY_ENABLED=false

# ── Wise ─────────────────────────────────────────────────
WISE_API_KEY=your-wise-api-key
WISE_WEBHOOK_SECRET=your-wise-webhook-secret

# ── Runtime ──────────────────────────────────────────────
# Set to 'true' to enable mock data in non-dev environments
# EXPO_PUBLIC_ENABLE_RUNTIME_MOCKS=false

# ── Sentry (Error Tracking) ─────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload (EAS Build / OTA symbolication).
# SENTRY_AUTH_TOKEN is a build-time secret — do NOT place it in .env.
# Set it via EAS:
#   eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value <token>
# These are read by the @sentry/react-native/expo config plugin in app.config.js
# and only activate the plugin when SENTRY_AUTH_TOKEN is present.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# SENTRY_AUTH_TOKEN: set via `eas secret:create` (not committed here)

# ── PostHog (Product Analytics) ──────────────────────────
# Required for analytics tracking. Without these, track() calls no-op
# and no product analytics data is collected.
# Get your key from https://app.posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# Host defaults to https://eu.i.posthog.com — set to https://app.posthog.com for US cloud
# EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
