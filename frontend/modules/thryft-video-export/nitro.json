{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["videoexport"],
  "ios": {
    "iosModuleName": "ThryftVideoExport"
  },
  "android": {
    "androidNamespace": ["videoexport"],
    "androidCxxLibName": "ThryftVideoExport"
  },
  "autolinking": {
    "VideoExportModule": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVideoExportModule"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridVideoExportModule"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
