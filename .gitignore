# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
backend/.env

# backend build output
backend/api/dist/

# Python runtime/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# typescript
*.tsbuildinfo

# generated native folders (Expo prebuild output, now under frontend/)
frontend/ios/
frontend/android/

# Kotlin/Gradle build output for local native modules
frontend/modules/*/android/build/
frontend/modules/*/ios/build/

# local git metadata backup folder
.git_disabled/

# cleanup quarantine (recoverable, not tracked)
trash/

# IDE
.idea/

# EAS Update code signing private keys (generated outside the repo)
frontend/keys/

# Bug reports and temp files
.commit-msg.txt
bugreport-*/

# Flagship elevation planning docs (all .md)
thryftverse_flagship_elevation_phase_2_*/
