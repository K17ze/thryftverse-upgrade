# Backend API base URL (backend/api). Defaults to http://localhost:4000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Data mode: "fixture" renders the bundled design dataset offline,
# "live" talks to the backend API. Defaults to fixture.
NEXT_PUBLIC_DATA_MODE=fixture

# Canonical site origin — used for metadataBase, sitemap and robots
# absolute URLs. Defaults to https://www.thryftverse.com.
NEXT_PUBLIC_SITE_URL=https://www.thryftverse.com
