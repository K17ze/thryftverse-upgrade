# nginx-tls — minimal nginx reverse proxy that terminates TLS for local
# development and forwards plaintext HTTP to the api container on port 4000.
#
# !!! LOCAL DEV ONLY !!!
# The certificates mounted into this image are self-signed and generated by
# frontend/scripts/generate-local-spki-hashes.sh. They MUST NOT be used in
# production. See frontend/docs/SSL_PINNING_SETUP.md.
#
# Build context: docker/nginx/
#   docker build -t thryftverse/nginx-tls docker/nginx
FROM nginx:1.27-alpine

# Remove the default site config — we ship our own via the COPY below.
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy the reverse-proxy config that terminates TLS and forwards to the
# upstream api service on port 4000.
COPY nginx.conf /etc/nginx/conf.d/thryftverse-tls.conf

# The certs/ directory is populated by generate-local-spki-hashes.sh.
# We copy the CA cert and the API primary cert/key pair. The CA cert is
# served at /.well-known/ca so clients/emulators can install it if needed.
COPY certs/ca.crt        /etc/nginx/certs/ca.crt
COPY certs/api-primary.crt /etc/nginx/certs/server.crt
COPY certs/api-primary.key /etc/nginx/certs/server.key

# Ensure nginx can read the private key.
RUN chmod 644 /etc/nginx/certs/server.crt /etc/nginx/certs/ca.crt \
 && chmod 640 /etc/nginx/certs/server.key

EXPOSE 4443

# nginx:alpine starts the master process by default; no custom CMD needed.
